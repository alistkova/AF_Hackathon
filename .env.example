# Go/Node/Python monorepo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
GATEWAY_PORT=8080
WEB_PORT=3000

REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

COMPANY_DATABASE_URL=postgres://company_svc:company@localhost:5432/company_db?sslmode=disable
CONTENT_DATABASE_URL=postgres://content_svc:content@localhost:5432/content_db?sslmode=disable
INSIGHT_DATABASE_URL=postgres://insight_svc:insight@localhost:5432/insight_db?sslmode=disable
IDENTITY_DATABASE_URL=postgres://identity_svc:identity@localhost:5432/identity_db?sslmode=disable

GATEWAY_ADDR=:8080
VITE_PROXY_TARGET=http://localhost:8080
COMPANY_ADDR=:8081
CONTENT_ADDR=:8082
INSIGHT_ADDR=:8083
IDENTITY_ADDR=:8086
AGENT_ADDR=:8090

CONTENT_DATA_DIR=./.data/content

COMPANY_URL=http://localhost:8081
CONTENT_URL=http://localhost:8082
INSIGHT_URL=http://localhost:8083
IDENTITY_URL=http://localhost:8086
AGENT_URL=http://localhost:8090

AGENT_MODE=stub
ANALYZER_MODE=agent
AGENT_TIMEOUT=120s
AGENT_STEP_DELAY=350ms

LLM_BASE_URL=
# Optional fallback endpoint, used only if LLM_BASE_URL is unreachable.
LLM_FALLBACK_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

SESSION_COOKIE_NAME=alfa_session
SESSION_COOKIE_SECURE=false
# Shared secret for the gateway-to-identity internal membership call.
IDENTITY_INTERNAL_TOKEN=dev-internal-token
IDENTITY_SESSION_TTL=168h
IDENTITY_SESSION_PRUNE_INTERVAL=1h
# Disable after creating the demo or production accounts.
IDENTITY_REGISTRATION_ENABLED=true

# Demo accounts created by scripts/bootstrap-users.sh
DEMO_ADMIN_COMPANIES="magnit severstal sber"
DEMO_CLIENT_COMPANIES="magnit severstal"
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOGIN_WINDOW=15m

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=raw-documents

# RAG system (services/agent): storage via CONTENT_URL, ingestion state in RAG_INDEX_DIR
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-5.6-sol
RAG_INDEX_DIR=.rag/index
RAG_DATA_DIR=data
RAG_USE_OCR=False

# Product LLM metrics (services/agent): JSONL sink + stdout
METRICS_ENABLED=true
# Optional absolute path; default: <agent>/metrics
# METRICS_DIR=
